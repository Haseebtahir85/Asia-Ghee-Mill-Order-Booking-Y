# Supabase project settings (server-side only — never expose the service role key to the client)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin panel protection (simple password gate for /admin/*)
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_SESSION_SECRET=any-long-random-string-used-to-sign-the-session-cookie
